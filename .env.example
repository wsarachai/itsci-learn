# คัดลอกไฟล์นี้เป็น .env แล้วปรับแต่งตามต้องการ (ห้าม commit .env จริงขึ้น Git)
SITE_ADDRESS=localhost

# ฐานข้อมูล PostgreSQL
POSTGRES_DB=wellness
POSTGRES_USER=wellness_user
POSTGRES_PASSWORD=change-me-postgres-password

# ระบบส่งอีเมล (Gmail SMTP - Optional: หากเว้นว่างไว้ รหัสผ่านอนุมัติจะแสดงใน Server Log)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
