{
	# SITE_ADDRESS เช่น 10.1.245.36 หรือ localhost (ตั้งใน .env)
	local_certs
	default_sni {$SITE_ADDRESS}
}

(app) {
	encode zstd gzip

	handle /uploads/* {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}

https://{$SITE_ADDRESS} {
	tls internal
	import app
}

http://{$SITE_ADDRESS} {
	import app
}
